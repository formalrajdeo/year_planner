APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_MINUTES=1440
MONGODB_URI=mongodb://USER:URL_ENCODED_PASSWORD@127.0.0.1:27018/?authSource=admin&retryWrites=true&w=majority
MONGODB_DATABASE=year_planner
MONGODB_MAX_POOL_SIZE=100
MONGODB_TIMEOUT_SECONDS=10
# Optional in development. Password recovery returns 503 until configured.
# Production requires SMTP configuration and encrypted SMTP transport.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Year Planner <no-reply@example.com>
